# Copy to .env.local (gitignored) and fill in. Every variable is read at call
# time, never at import time — `npm run build` succeeds with none of them set.

# ── Supabase ─────────────────────────────────────────────────────────────
# Project settings → API. New-style key names; legacy anon / service_role JWT
# keys also work in these slots.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. BYPASSES ROW LEVEL SECURITY — payment webhook and background
# jobs only. Never expose to the client bundle.
SUPABASE_SECRET_KEY=

# ── Token encryption ─────────────────────────────────────────────────────
# base64 of exactly 32 random bytes. Generate: openssl rand -base64 32
# No fallback exists by design: token encryption THROWS if this is missing or
# malformed. Losing this key means every stored OAuth connection must be
# re-authorized.
TOKEN_ENCRYPTION_KEY=

# ── Platform adapters ────────────────────────────────────────────────────
# Each pair unlocks its platform's Connect toggle; unset = the dashboard
# shows that platform as "Coming soon" and /api/connect answers 503.
# META_APP_ID=
# META_APP_SECRET=

# TikTok Content Posting API (developers.tiktok.com — note: client KEY, not id).
# Pre-audit, TikTok forces every post to SELF_ONLY on a private account.
# PULL_FROM_URL also requires R2_PUBLIC_BASE_URL's domain to be verified as
# owned in the TikTok developer portal — a pub-*.r2.dev URL can never pass
# that, so TikTok publishing needs the R2 custom domain first.
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=

# X API v2, OAuth2 confidential client (console.x.com → your app → OAuth 2.0).
# Pay-per-use billing: prepaid credits on the app, $0.015/post. These are the
# OAuth 2.0 Client ID and Client Secret — NOT the v1.1 API key pair.
# X_CLIENT_ID=
# X_CLIENT_SECRET=

# Google OAuth client for YouTube uploads (console.cloud.google.com →
# credentials → OAuth client, type Web application). Unverified API projects
# have every upload locked to private until the YouTube API audit passes.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Snapchat Public Profile API (business.snapchat.com → Business Details →
# OAuth apps). Allowlist-only: email dev-support@snap.com with the client_id
# to request access. Posts Spotlight to Public Profiles.
# SNAPCHAT_CLIENT_ID=
# SNAPCHAT_CLIENT_SECRET=
# Media uploads (Cloudflare R2, S3 API). All five must be set or the composer
# hides its file picker and asks for a public URL instead — see
# isMediaStorageConfigured(). The bucket must allow public reads: the platforms
# fetch media by URL at publish time.
# R2_PUBLIC_BASE_URL is the r2.dev subdomain or a custom domain, no trailing slash.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=markedfox-media
# R2_PUBLIC_BASE_URL=https://pub-xxxxxxxx.r2.dev
# Phase 6 — payments
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Absolute base URL for links inside auth emails (confirmation, password reset).
# Required in production; falls back to the request host in development.
NEXT_PUBLIC_SITE_URL=https://markedfox.com

# Threads uses a SEPARATE API (graph.threads.net) with its own app credentials —
# these are not the same values as META_APP_ID / META_APP_SECRET. Add the
# Threads API product to the Meta app, then copy its id and secret here.
THREADS_APP_ID=
THREADS_APP_SECRET=

# ── Scheduler ────────────────────────────────────────────────────────────
# Shared secret between scripts/run-scheduler.mjs (the systemd timer) and
# POST /api/internal/scheduler/tick. Generate: openssl rand -base64 32
# Unset = the tick endpoint refuses everything and no scheduled post publishes.
SCHEDULER_SECRET=

# The DM engine's webhook. Meta calls GET /api/webhooks/meta once with this
# token when the owner saves the callback URL on the app's Webhooks product
# (Instagram object: comments, messages, messaging_postbacks); POST
# deliveries are verified with META_APP_SECRET instead. Any random string —
# generate: openssl rand -hex 16 — and paste the same value into the Meta
# dashboard's "Verify token" field.
META_WEBHOOK_VERIFY_TOKEN=

# ── Research (pillar 3) ──────────────────────────────────────────────────
# YouTube Data API v3 key. A PLAIN API KEY, not OAuth, and a different
# credential from GOOGLE_CLIENT_ID/SECRET (which the YouTube publishing
# adapter uses). It reads public channel and video statistics, so research
# works before the upload audit lands. Create at console.cloud.google.com →
# APIs & Services → Credentials → API key, with the YouTube Data API v3
# enabled. Free quota is 10,000 units/day; a channel sync costs ~3.
# Unset = YouTube research shows as unconfigured; nothing else is affected.
YOUTUBE_API_KEY=

# X API v2 app-only bearer token, for reading public accounts' posts.
# READS ARE BILLED PER REQUEST on the pay-per-use plan, which is why X
# research sources sync less often and pull fewer posts than YouTube's.
X_BEARER_TOKEN=

# ── AI (research script generation) ──────────────────────────────────────
# One of these turns on hook/outline/script generation. Gemini wins if both
# are set. Without either, channel tracking and outlier scoring still work
# and the generate button says so rather than failing.
GEMINI_API_KEY=
# Optional override; defaults to gemini-2.5-flash.
GEMINI_MODEL=
GROQ_API_KEY=
# Optional override; defaults to llama-3.3-70b-versatile.
GROQ_MODEL=
