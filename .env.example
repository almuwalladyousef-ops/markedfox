# Copy to .env.local (gitignored) and fill in. Every variable is read at call
# time, never at import time — `npm run build` succeeds with none of them set.

# ── Supabase ─────────────────────────────────────────────────────────────
# Project settings → API. New-style key names; legacy anon / service_role JWT
# keys also work in these slots.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. BYPASSES ROW LEVEL SECURITY — payment webhook and background
# jobs only. Never expose to the client bundle.
SUPABASE_SECRET_KEY=

# ── Token encryption ─────────────────────────────────────────────────────
# base64 of exactly 32 random bytes. Generate: openssl rand -base64 32
# No fallback exists by design: token encryption THROWS if this is missing or
# malformed. Losing this key means every stored OAuth connection must be
# re-authorized.
TOKEN_ENCRYPTION_KEY=

# ── Later phases (placeholders, not read by any code yet) ────────────────
# Phase 3 — platform adapters
# META_APP_ID=
# META_APP_SECRET=
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# X_API_KEY=
# X_API_SECRET=
# Phase 6 — media lifecycle (Cloudflare R2)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# Phase 6 — payments
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Absolute base URL for links inside auth emails (confirmation, password reset).
# Required in production; falls back to the request host in development.
NEXT_PUBLIC_SITE_URL=https://markedfox.com

# Threads uses a SEPARATE API (graph.threads.net) with its own app credentials —
# these are not the same values as META_APP_ID / META_APP_SECRET. Add the
# Threads API product to the Meta app, then copy its id and secret here.
THREADS_APP_ID=
THREADS_APP_SECRET=

# ── Scheduler ────────────────────────────────────────────────────────────
# Shared secret between scripts/run-scheduler.mjs (the systemd timer) and
# POST /api/internal/scheduler/tick. Generate: openssl rand -base64 32
# Unset = the tick endpoint refuses everything and no scheduled post publishes.
SCHEDULER_SECRET=
