# Caddy handles TLS certificates automatically via Let's Encrypt. It needs
# ports 80 and 443 reachable and DNS already pointing at this droplet — the
# HTTP-01 challenge fails otherwise.
#
# Install to /etc/caddy/Caddyfile, then: sudo systemctl reload caddy

markedfox.com, www.markedfox.com {
	encode zstd gzip

	# Internal endpoints (the scheduler tick) are for the timer on this box,
	# which reaches the app on loopback and never through Caddy. From the
	# public side they do not exist. The endpoints also check a bearer secret;
	# this is the outer lock.
	@internal path /api/internal/*
	respond @internal 404

	# Methods the app does not implement are refused here rather than passed on.
	#
	# This has to live in Caddy rather than in src/proxy.ts, and the reason is
	# worth writing down: Next converts the Node request into a WHATWG Request
	# before middleware runs, and that constructor throws on TRACE, TRACK and
	# CONNECT ("TypeError: 'TRACE' HTTP method is unsupported"). The throw became
	# a bare `500 Internal Server Error`, which reads to a scanner as a server
	# that broke rather than a method that was declined. Middleware never got the
	# chance to answer. The guard in src/proxy.ts stays as the second line for
	# anything that does reach it.
	#
	# TRACE is also the method behind cross-site tracing, so refusing it is worth
	# doing for its own sake.
	@unsupported_method {
		not method GET HEAD POST PUT PATCH DELETE OPTIONS
	}
	# RFC 9110 requires a 405 to say what it would have accepted. POST and
	# OPTIONS are on that list deliberately: the Stripe and Meta webhooks POST,
	# and the browser preflights with OPTIONS.
	header @unsupported_method Allow "GET, HEAD, POST, PUT, PATCH, DELETE, OPTIONS"
	respond @unsupported_method "Method Not Allowed" 405

	# Next.js listens on loopback only. Caddy is the only thing bound to a
	# public port, so the app is never reachable except through TLS.
	reverse_proxy 127.0.0.1:3000

	header {
		# HSTS. Note the two-year max-age and preload: once a browser sees this,
		# it refuses plain HTTP for the domain for that long. Serving the site
		# over HTTPS is therefore a commitment, not a toggle.
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Locks down what the page may reach. Kept deliberately tight now, while
		# there is no third-party script; loosen it deliberately rather than
		# discovering it is already wide open.
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
		-Server
	}

	# Access logs go to stderr, which systemd captures in the journal alongside
	# every other service. `journalctl -u caddy` reads them; a file under
	# /var/log collided with Caddy's own unit sandbox and is not worth fighting.
	log {
		output stderr
	}
}
