# Copy to /srv/markedfox/.env.production, fill in, chmod 600, owner markedfox.
#
#   sudo install -m 600 -o markedfox -g markedfox \
#     deploy/env.production.example /srv/markedfox/.env.production
#   sudo -u markedfox nano /srv/markedfox/.env.production
#
# systemd reads this file directly, so it is plain KEY=value with no `export`,
# no quotes around values, and no shell expansion.

# ── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://pktdpxpafycyqiusvyhq.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Bypasses RLS entirely. Only the scheduler and other server-side jobs use it.
SUPABASE_SECRET_KEY=

# ── Application ─────────────────────────────────────────────────────────────
# Absolute base for links inside auth emails. Without it those links are built
# from the request host, which is wrong behind a proxy.
NEXT_PUBLIC_SITE_URL=https://markedfox.com

# AES-256-GCM key for platform OAuth tokens at rest. Generate once:
#   openssl rand -base64 32
# Changing it makes every stored connection undecryptable — users would have to
# reconnect every account. Back it up with the same care as the role account.
TOKEN_ENCRYPTION_KEY=

# Encrypts Server Action closures. Next.js generates one per build if unset,
# which breaks in-flight actions across a restart and across multiple instances.
# Generate once and keep it stable:
#   openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Shared secret between the scheduler timer (scripts/run-scheduler.mjs) and the
# app's POST /api/internal/scheduler/tick. Both read this same file. Generate:
#   openssl rand -base64 32
# Unset = no scheduled post ever publishes (the endpoint fails closed).
SCHEDULER_SECRET=
# Meta webhook verification token (see .env.example).
META_WEBHOOK_VERIFY_TOKEN=

# ── Platform credentials (Phase 3 onward; leave blank until each app exists) ──
# A platform whose pair is blank renders as "Setup needed" in the dashboard
# and its /api/connect answers 503 — it is never silently missing. Which is
# also why this list has to stay complete: a fresh box provisioned from a
# template that has forgotten a platform loses it with no error anywhere.
META_APP_ID=
META_APP_SECRET=
THREADS_APP_ID=
THREADS_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# X (console.x.com → app → OAuth 2.0). The OAuth 2.0 Client ID and Secret,
# NOT the v1.1 API key pair. Posting is pay-per-use and needs credits on the
# account: $0.015 a post, $0.20 with a link.
X_CLIENT_ID=
X_CLIENT_SECRET=
# YouTube uploads (console.cloud.google.com → Credentials → OAuth client, type
# Web application). Separate credential from YOUTUBE_API_KEY below, which is
# research-only. Until the YouTube API audit passes, every upload is locked to
# private with no appeal.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Snapchat (kit.snapchat.com → your app → Setup). The CONFIDENTIAL OAuth 2.0
# client id and secret, not the public one. Login Kit scopes stay unauthorized
# until Snap approves the app for review.
SNAPCHAT_CLIENT_ID=
SNAPCHAT_CLIENT_SECRET=

# ── Media uploads (Cloudflare R2, S3 API) ───────────────────────────────────
# All five or none: with any missing, the composer hides its file picker and
# asks for a public URL instead. The bucket must allow public reads — the
# platforms fetch media by URL at publish time.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=markedfox-media
# The r2.dev subdomain or a custom domain. No trailing slash.
R2_PUBLIC_BASE_URL=

# ── Research (pillar 3) ─────────────────────────────────────────────────────
# YouTube Data API v3 key — a plain API key, separate from the publishing
# adapter's OAuth client. Unset = YouTube research shows as unconfigured.
YOUTUBE_API_KEY=
# X app-only bearer token. Reads are billed per request.
X_BEARER_TOKEN=
# One AI key turns on script generation; Gemini wins if both are present.
GEMINI_API_KEY=
GROQ_API_KEY=
# Also the speech model for transcripts. YouTube serves caption tracks;
# Instagram serves none, so its audio is transcribed with whisper-large-v3-turbo
# on this key. Text generation is unaffected — Gemini still wins when both keys
# are set.
# Optional model overrides. Defaults: gemini-3.6-flash, llama-3.3-70b-versatile.
GEMINI_MODEL=
GROQ_MODEL=

# ── Billing (Stripe) ────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
