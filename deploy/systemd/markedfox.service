[Unit]
Description=MarkedFox web application
Documentation=https://markedfox.com
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=markedfox
Group=markedfox
WorkingDirectory=/srv/markedfox/current
EnvironmentFile=/srv/markedfox/.env.production

# Bound to loopback deliberately: Caddy is the only public listener, so the
# app cannot be reached except through TLS even if the firewall is wrong.
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOSTNAME=127.0.0.1

# next.config.ts sets output: "standalone" — a self-contained server with only
# the modules it needs. `next start` refuses to serve that layout, so run the
# emitted server directly. deploy.sh copies public/ and .next/static beside it,
# which Next deliberately leaves to the deployer.
ExecStart=/usr/bin/node .next/standalone/server.js

# Always come back up — an unhandled rejection at 3am must not mean the site is
# down until someone notices. StartLimit stops a crash loop from thrashing.
Restart=always
RestartSec=3
StartLimitIntervalSec=60
StartLimitBurst=5

# Sandboxing. The app needs its own directory and outbound network, nothing else.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths=/srv/markedfox
# AF_NETLINK is required: Node's os.networkInterfaces() (which next start
# calls at boot to print its Network: line) enumerates interfaces over
# netlink, and without it the process dies with uv_interface_addresses
# error 97 (EAFNOSUPPORT). Learned on the first real deploy.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
LockPersonality=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=markedfox

[Install]
WantedBy=multi-user.target
